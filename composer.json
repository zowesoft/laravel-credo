{
    "name": "zowesoft/laravel-credo",
    "description": "A fluent Laravel package for the Credo payment gateway (credocentral.com / credodemo.com).",
    "keywords": [
        "laravel",
        "credo",
        "credocentral",
        "credo-payments",
        "payment-gateway",
        "payments",
        "nigeria"
    ],
    "homepage": "https://github.com/zowesoft/laravel-credo",
    "license": "MIT",
    "authors": [
        {
            "name": "Zowesoft",
            "homepage": "https://zowesoft.com",
            "role": "Owner"
        },
        {
            "name": "Ifeanyichukwu John",
            "email": "Ifeanyichukwujohn70@gmail.com",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/contracts": "^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8",
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^7.22",
        "pestphp/pest": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "ZoweSoft\\LaravelCredo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ZoweSoft\\LaravelCredo\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "vendor/bin/pint",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ZoweSoft\\LaravelCredo\\CredoServiceProvider"
            ],
            "aliases": {
                "Credo": "ZoweSoft\\LaravelCredo\\Facades\\Credo"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
